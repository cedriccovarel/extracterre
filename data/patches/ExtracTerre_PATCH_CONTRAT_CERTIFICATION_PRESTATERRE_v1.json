{
  "schema": "extracterre-improvement-patch/v1",
  "id": "prestaterre-contrat-certification-v1",
  "version": "1.0.0",
  "minAppVersion": "1.1.15",
  "title": "Contrat de certification Prestaterre — structure générique",
  "description": "Signatures et extractions strictes pour les contrats de certification Prestaterre. Le patch se base sur la structure métier (Contrat de certification, Demande de certification, Objet de la certification, Référentiel, Mention(s), Ouvrage, Montant) et non sur le nom du fichier, le client ou l'opération. Compatible avec PDF texte ou PDF scanné après OCR.",
  "documentSignatures": [
    {
      "docType": "Contrat",
      "weight": 45,
      "all": [
        "contrat de certification"
      ],
      "any": [
        "demande de certification",
        "objet de la certification",
        "organisme certificateur",
        "candidat à la certification"
      ]
    },
    {
      "docType": "Contrat",
      "weight": 28,
      "all": [
        "article 1",
        "référentiel"
      ],
      "any": [
        "mention(s) et niveau(x)",
        "profil",
        "niveau(x) énergie"
      ]
    },
    {
      "docType": "Contrat",
      "weight": 24,
      "all": [
        "article 2",
        "nom de l'opération"
      ],
      "any": [
        "ouvrage",
        "adresse de l'opération",
        "parcelle(s)"
      ]
    }
  ],
  "extractionRules": [
    {
      "id": "contract-owner-candidate",
      "field": "owner_company",
      "docTypes": [
        "Contrat"
      ],
      "regex": "(?:^|\\n)\\s*Et\\s*:\\s*(?:\\r?\\n\\s*)?([^\\n\\r]{2,120})",
      "valueGroup": 1,
      "valueType": "text",
      "confidence": 0.995,
      "maxMatches": 1,
      "requireAny": [
        "candidat à la certification"
      ],
      "note": "Le cocontractant/candidat figurant après « Et : » est utilisé comme maître d'ouvrage/candidat, uniquement dans un document classé Contrat."
    },
    {
      "id": "contract-reference-name",
      "field": "reference_name",
      "docTypes": [
        "Contrat"
      ],
      "regex": "R[eé]f[eé]rentiel\\s*:\\s*([^\\n\\r]{3,140}?)(?:\\s*[–—-]\\s*Version\\s+([A-Za-z0-9._-]+))?\\s*(?:\\r?$)",
      "valueGroup": 1,
      "valueType": "text",
      "confidence": 0.999,
